{
  "manifest_version": 3,
  "name": "Act IA QA Annotator",
  "version": "0.2.0",
  "description": "Captura anotações de QA no navegador e envia para a Central QA do Act IA.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://ide.builtt.com.br/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Act IA QA"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
