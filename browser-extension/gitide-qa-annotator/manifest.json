{
  "manifest_version": 3,
  "name": "GitIDE QA Annotator",
  "version": "0.1.0",
  "description": "Captura anotações de QA no navegador e envia para a Central QA do GitIDE.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "GitIDE QA"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
